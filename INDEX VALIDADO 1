<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cockpit Executivo - Gestão de Projetos TOTVS</title>
    <!-- Fontes e Ícones -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        :root {
            /* TOTVS Palette */
            --totvs-blue-dark: #004a80;
            --totvs-blue-light: #00a1e4;
            --totvs-green: #00b140;
            --totvs-gray-bg: #f4f7fa;
            --totvs-text: #2c3e50;
            --totvs-white: #ffffff;
            --border-radius: 16px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--totvs-gray-bg);
            color: var(--totvs-text);
            overflow-x: hidden;
        }

        /* --- LOGIN SCREEN --- */
        #login-screen {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--totvs-blue-dark) 0%, #002d50 100%);
        }

        .login-card {
            background: white;
            padding: 50px;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
            width: 100%;
            max-width: 420px;
            text-align: center;
        }

        .login-card h1 {
            color: var(--totvs-blue-dark);
            margin-bottom: 30px;
            font-weight: 800;
            font-size: 26px;
            letter-spacing: -1px;
        }

        .form-group {
            text-align: left;
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 700;
            color: var(--totvs-blue-dark);
            text-transform: uppercase;
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 14px 18px;
            border: 2px solid #eef2f7;
            border-radius: 12px;
            outline: none;
            transition: var(--transition);
            font-size: 15px;
            background: white;
            font-family: inherit;
        }

        .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--totvs-blue-light); box-shadow: 0 0 0 4px rgba(0, 161, 228, 0.1); }

        .btn-primary {
            width: 100%;
            padding: 16px;
            background: var(--totvs-blue-light);
            color: white;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            font-size: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-primary:hover { background: var(--totvs-blue-dark); transform: translateY(-2px); }

        /* --- SIDEBAR --- */
        #main-app { display: none; min-height: 100vh; }

        .sidebar {
            width: 280px;
            background: var(--totvs-blue-dark);
            color: white;
            position: fixed;
            height: 100vh;
            padding: 30px 24px;
            display: flex;
            flex-direction: column;
            z-index: 100;
            overflow-y: auto;
        }

        .sidebar .logo {
            font-size: 24px;
            font-weight: 900;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 12px;
            letter-spacing: -0.5px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 16px;
            border-radius: 12px;
            cursor: pointer;
            margin-bottom: 4px;
            transition: var(--transition);
            font-weight: 600;
            color: rgba(255,255,255,0.7);
            font-size: 13px;
        }

        .nav-item:hover, .nav-item.active {
            background: rgba(255,255,255,0.1);
            color: white;
        }

        .nav-separator {
            height: 1px;
            background: rgba(255,255,255,0.1);
            margin: 10px 0;
        }

        /* --- CONTENT --- */
        .content {
            margin-left: 280px;
            padding: 30px 50px;
            width: calc(100% - 280px);
        }

        .card {
            background: white;
            border-radius: var(--border-radius);
            padding: 25px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.02);
            margin-bottom: 25px;
            border: 1px solid #f1f5f9;
        }

        /* --- ROADMAP CARDS --- */
        .roadmap-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .roadmap-card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            border: 1px solid #eef2f7;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .roadmap-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);
            border-color: var(--totvs-blue-light);
        }

        .roadmap-card .title {
            font-weight: 800;
            color: var(--totvs-blue-dark);
            font-size: 16px;
        }

        .roadmap-card .info {
            font-size: 12px;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .roadmap-card .badge {
            background: #f1f5f9;
            color: #475569;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            align-self: flex-start;
        }

        /* --- KPI GRID --- */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
        }

        .kpi-card {
            background: white;
            padding: 20px;
            border-radius: var(--border-radius);
            display: flex;
            align-items: center;
            gap: 12px;
            border-bottom: 4px solid transparent;
            transition: var(--transition);
            cursor: pointer;
        }

        .kpi-card:hover { transform: translateY(-3px); box-shadow: 0 15px 20px -5px rgba(0,0,0,0.05); }
        .kpi-card.pendencias { border-color: #f59e0b; }
        .kpi-card.riscos { border-color: #ef4444; }
        .kpi-card.stakeholders { border-color: var(--totvs-blue-light); }
        .kpi-card.gaps { border-color: #8b5cf6; }

        .kpi-icon {
            width: 45px;
            height: 45px;
            background: #f8fafc;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--totvs-blue-dark);
        }

        .kpi-data h3 { font-size: 10px; color: var(--secondary-text); text-transform: uppercase; letter-spacing: 0.5px; }
        .kpi-data p { font-size: 22px; font-weight: 800; color: var(--totvs-blue-dark); }

        /* --- TIMER --- */
        .sync-control-container {
            display: flex;
            flex-direction: column;
            gap: 8px;
            background: white;
            padding: 12px 20px;
            border-radius: 12px;
            border: 1px solid #eef2f7;
            min-width: 300px;
        }

        .timer-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 11px;
            font-weight: 700;
            color: var(--totvs-blue-dark);
        }

        .progress-bar-bg { width: 100%; height: 5px; background: #f1f5f9; border-radius: 10px; overflow: hidden; }
        .progress-bar-fill { height: 100%; width: 100%; background: var(--totvs-blue-light); transition: width 1s linear; }

        /* --- ROADMAP EDITOR --- */
        .roadmap-editor {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: white;
            z-index: 1000;
            padding: 40px;
            overflow-y: auto;
            display: none;
        }

        .editor-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
            border-bottom: 1px solid #eee;
            padding-bottom: 20px;
        }

        .roadmap-table-input {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        .roadmap-table-input th {
            background: var(--totvs-blue-dark);
            color: white;
            padding: 12px;
            font-size: 11px;
            text-transform: uppercase;
        }

        .roadmap-table-input td {
            padding: 6px;
            border: 1px solid #e2e8f0;
        }

        .roadmap-table-input input, .roadmap-table-input select {
            width: 100%;
            border: none;
            padding: 6px;
            background: transparent;
            outline: none;
            font-size: 12px;
        }

        /* --- COMMON UI --- */
        .hidden { display: none !important; }

        .btn-icon {
            background: #f1f5f9;
            border: none;
            width: 32px;
            height: 32px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            transition: var(--transition);
        }

        .btn-icon:hover { background: #e2e8f0; color: var(--totvs-blue-dark); }
        .btn-icon.delete:hover { background: #fee2e2; color: #ef4444; }

        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: var(--totvs-blue-dark);
            color: white;
            padding: 15px 25px;
            border-radius: 12px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            transform: translateY(150px);
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 2000;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }
        .toast.show { transform: translateY(0); }
        .loading-spinner { animation: spin 1s linear infinite; }
        @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

        /* --- STAKEHOLDER SELECTOR --- */
        .participant-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 10px;
        }

        .participant-tag {
            background: #e0f2fe;
            color: #0369a1;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .participant-tag i { cursor: pointer; }
    </style>
</head>
<body>

    <!-- TELA DE LOGIN -->
    <div id="login-screen">
        <div class="login-card">
            <div style="color: var(--totvs-blue-light); margin-bottom: 20px;">
                <i data-lucide="shield-check" style="width: 64px; height: 64px;"></i>
            </div>
            <h1>Acesso Executivo</h1>
            <div class="form-group">
                <label>Administrador</label>
                <input type="text" id="username" placeholder="Usuário">
            </div>
            <div class="form-group">
                <label>Senha</label>
                <input type="password" id="password" placeholder="••••••••">
            </div>
            <button class="btn-primary" onclick="handleLogin()">Entrar</button>
            <p id="login-error" style="color: #ef4444; font-size: 13px; margin-top: 15px; display: none; font-weight: 600;">Credenciais incorretas.</p>
        </div>
    </div>

    <!-- MAIN APP -->
    <div id="main-app">
        <aside class="sidebar">
            <div class="logo"><i data-lucide="gauge" style="color: var(--totvs-blue-light);"></i> COCKPIT</div>
            <nav>
                <div class="nav-item active" id="nav-cockpit" onclick="showPage('cockpit', this)"><i data-lucide="pie-chart"></i> Visão Geral</div>
                <div class="nav-separator"></div>
                <div class="nav-item" id="nav-status" onclick="showPage('status', this)"><i data-lucide="file-text"></i> Status Report</div>
                <div class="nav-item" id="nav-pendencias" onclick="showPage('pendencias', this)"><i data-lucide="check-square"></i> Pendências</div>
                <div class="nav-item" id="nav-riscos" onclick="showPage('riscos', this)"><i data-lucide="alert-circle"></i> Riscos</div>
                <div class="nav-item" id="nav-gaps" onclick="showPage('gaps', this)"><i data-lucide="git-pull-request"></i> Gaps e Mudanças</div>
                <div class="nav-item" id="nav-stakeholders" onclick="showPage('stakeholders', this)"><i data-lucide="user-plus"></i> Stakeholders</div>
                <div class="nav-separator"></div>
                <div class="nav-item" id="nav-treinamentos" onclick="showPage('treinamentos', this)"><i data-lucide="graduation-cap"></i> Treinamentos</div>
                <div class="nav-item" id="nav-agenda" onclick="showPage('agenda', this)"><i data-lucide="calendar-clock"></i> Agenda de Treinos</div>
                <div class="nav-separator"></div>
                <div class="nav-item" id="nav-config" onclick="showPage('config', this)"><i data-lucide="sliders"></i> Configurações</div>
            </nav>
            <div class="nav-item" style="margin-top: auto;" onclick="handleLogout()"><i data-lucide="power"></i> Encerrar Sessão</div>
        </aside>

        <main class="content">
            <!-- PAGE: COCKPIT -->
            <div id="page-cockpit">
                <div class="page-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                    <div>
                        <h2>Dashboard de Gestão</h2>
                        <p style="color: #64748b; font-size: 14px;">Monitoramento Estratégico TOTVS</p>
                    </div>
                    
                    <div class="sync-control-container">
                        <div class="timer-info">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <i data-lucide="clock" style="width: 14px;"></i>
                                Próxima atualização: <span id="timer-text">00:00</span>
                            </div>
                            <button class="sync-btn" onclick="forceSync()">
                                <i data-lucide="refresh-cw" id="sync-icon"></i> Forçar Sync
                            </button>
                        </div>
                        <div class="progress-bar-bg">
                            <div class="progress-bar-fill" id="progress-fill"></div>
                        </div>
                    </div>
                </div>

                <!-- KPI GRID -->
                <div class="kpi-grid">
                    <div class="kpi-card pendencias" onclick="showPage('pendencias', document.getElementById('nav-pendencias'))">
                        <div class="kpi-icon"><i data-lucide="check-square"></i></div>
                        <div class="kpi-data"><h3>Pendências</h3><p id="val-pendencias">0</p></div>
                    </div>
                    <div class="kpi-card riscos" onclick="showPage('riscos', document.getElementById('nav-riscos'))">
                        <div class="kpi-icon"><i data-lucide="alert-circle"></i></div>
                        <div class="kpi-data"><h3>Riscos</h3><p id="val-riscos">0</p></div>
                    </div>
                    <div class="kpi-card gaps" onclick="showPage('gaps', document.getElementById('nav-gaps'))">
                        <div class="kpi-icon"><i data-lucide="git-pull-request"></i></div>
                        <div class="kpi-data"><h3>Gaps</h3><p id="val-gaps">0</p></div>
                    </div>
                    <div class="kpi-card stakeholders" onclick="showPage('stakeholders', document.getElementById('nav-stakeholders'))">
                        <div class="kpi-icon"><i data-lucide="user-plus"></i></div>
                        <div class="kpi-data"><h3>Pessoas</h3><p id="val-stakeholders">0</p></div>
                    </div>
                </div>

                <div class="card" style="margin-top: 25px; display: flex; justify-content: space-between; align-items: center;">
                    <div style="display: flex; align-items: center; gap: 8px; color: #64748b; font-size: 12px;">
                        <i data-lucide="info" style="width: 14px;"></i>
                        <span>Sync: <strong id="last-sync-time">--</strong></span>
                    </div>
                    <div id="current-date" style="font-weight: 700; color: var(--totvs-blue-dark); font-size: 12px;"></div>
                </div>
            </div>

            <!-- PAGE: TREINAMENTOS -->
            <div id="page-treinamentos" class="hidden">
                <div class="page-header" style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <h2>Roteiros de Treinamento</h2>
                        <p style="color: #64748b;">Gestão de trilhas e execução de capacitação</p>
                    </div>
                    <button class="btn-primary" style="width: auto; padding: 12px 25px;" onclick="openNewRoadmap()">
                        <i data-lucide="plus"></i> Novo Roteiro
                    </button>
                </div>
                <div class="roadmap-grid" id="roadmap-list"></div>
            </div>

            <!-- OUTRAS PÁGINAS (PLACEHOLDERS) -->
            <div id="page-status" class="hidden"><div class="card"><h2>Status Report</h2><p>Módulo de relatórios.</p></div></div>
            <div id="page-pendencias" class="hidden"><div class="card"><div class="table-container"><table id="table-pendencias"><thead></thead><tbody></tbody></table></div></div></div>
            <div id="page-riscos" class="hidden"><div class="card"><div class="table-container"><table id="table-riscos"><thead></thead><tbody></tbody></table></div></div></div>
            <div id="page-gaps" class="hidden"><div class="card"><div class="table-container"><table id="table-gaps"><thead></thead><tbody></tbody></table></div></div></div>
            <div id="page-stakeholders" class="hidden"><div class="card"><div class="table-container"><table id="table-stakeholders"><thead></thead><tbody></tbody></table></div></div></div>
            <div id="page-agenda" class="hidden"><div class="card"><div class="table-container"><table id="table-agenda"><thead></thead><tbody></tbody></table></div></div></div>

            <!-- PAGE: CONFIG -->
            <div id="page-config" class="hidden">
                <div class="card">
                    <h3>Configurações de Dados</h3>
                    <div class="config-section" style="margin-bottom: 25px; margin-top:20px;">
                        <label style="font-weight:700; font-size:12px; color:var(--totvs-blue-dark)">INTERVALO DE ATUALIZAÇÃO (MIN)</label>
                        <select id="update-interval" style="max-width:200px; display:block; margin-top:5px;">
                            <option value="1">1</option>
                            <option value="5" selected>5</option>
                            <option value="15">15</option>
                        </select>
                    </div>
                    <div id="config-rows-container"></div>
                    <button class="btn-primary" style="margin-top: 20px;" onclick="saveConfig()">Salvar Alterações</button>
                </div>
            </div>
        </main>
    </div>

    <!-- ROADMAP EDITOR MODAL -->
    <div id="roadmap-editor" class="roadmap-editor">
        <div class="editor-header">
            <div>
                <h1 id="editor-title">Editor de Roteiro</h1>
                <p id="editor-meta" style="color: #64748b; font-size: 14px;"></p>
            </div>
            <div style="display: flex; gap: 10px;">
                <button class="btn-primary" style="background: #10b981;" onclick="exportRoadmapToExcel()">
                    <i data-lucide="download"></i> Exportar Excel
                </button>
                <button class="btn-primary" onclick="saveRoadmap()">
                    <i data-lucide="save"></i> Salvar Roteiro
                </button>
                <button class="btn-primary" style="background: #f1f5f9; color: #64748b;" onclick="closeEditor()">
                    <i data-lucide="x"></i> Fechar
                </button>
            </div>
        </div>

        <div class="card" style="padding: 20px; background: #f8fafc;">
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
                <div class="form-group"><label>Título do Roteiro</label><input type="text" id="edit-roadmap-name"></div>
                <div class="form-group"><label>Instrutor / Responsável</label><input type="text" id="edit-roadmap-owner"></div>
                <div class="form-group">
                    <label>Adicionar Participante (do Mapa Stakeholders)</label>
                    <select id="participant-selector" onchange="addParticipant()">
                        <option value="">Selecione um participante...</option>
                    </select>
                    <div id="participant-tags" class="participant-list"></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <h3 style="font-size: 16px;">Estrutura do Treinamento</h3>
                <button class="btn-primary" style="width: auto; padding: 8px 15px; font-size: 12px;" onclick="addRoadmapRow()">
                    <i data-lucide="plus"></i> Adicionar Passo
                </button>
            </div>
            <div class="table-container">
                <table class="roadmap-table-input" id="roadmap-items-table">
                    <thead>
                        <tr>
                            <th style="width: 40px;">#</th>
                            <th style="width: 120px;">Sistema</th>
                            <th style="width: 120px;">Módulo</th>
                            <th>Processo de Negócio</th>
                            <th>Tarefa / Atividade</th>
                            <th style="width: 120px;">Status</th>
                            <th>Observações</th>
                            <th style="width: 40px;"></th>
                        </tr>
                    </thead>
                    <tbody id="roadmap-items-body"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- TOAST -->
    <div id="toast" class="toast"><i data-lucide="check-circle-2"></i><span id="toast-msg">Sucesso!</span></div>

    <script>
        // --- ESTADO ---
        let config = {
            password: 'admin',
            interval: 5,
            sources: {
                pendencias: { label: 'Pendências', url: '', range: '', hasHeader: true, color: '#f59e0b' },
                riscos: { label: 'Riscos', url: '', range: '', hasHeader: true, color: '#ef4444' },
                gaps: { label: 'Gaps', url: '', range: '', hasHeader: true, color: '#8b5cf6' },
                stakeholders: { label: 'Stakeholders', url: '', range: '', hasHeader: true, color: '#00a1e4' },
                agenda: { label: 'Agenda de Treinos', url: '', range: '', hasHeader: true, color: '#0f172a' }
            }
        };

        let roadmaps = [];
        let currentRoadmapId = null;
        let selectedParticipants = [];
        let dataStore = { pendencias: [], riscos: [], gaps: [], stakeholders: [], agenda: [] };
        let timeLeft = 0, totalSeconds = 0, timerInterval;

        // Persistência
        const savedConfig = localStorage.getItem('cockpit_config');
        if(savedConfig) config = JSON.parse(savedConfig);
        const savedRoadmaps = localStorage.getItem('cockpit_roadmaps');
        if(savedRoadmaps) roadmaps = JSON.parse(savedRoadmaps);

        // --- AUTH ---
        function handleLogin() {
            const u = document.getElementById('username').value, p = document.getElementById('password').value;
            if(u === 'admin' && p === config.password) {
                document.getElementById('login-screen').style.display = 'none';
                document.getElementById('main-app').style.display = 'flex';
                initApp();
            } else { 
                const err = document.getElementById('login-error');
                if(err) err.style.display = 'block'; 
            }
        }

        function handleLogout() { location.reload(); }

        function showPage(id, el) {
            ['cockpit', 'status', 'pendencias', 'riscos', 'gaps', 'stakeholders', 'treinamentos', 'agenda', 'config'].forEach(p => {
                const element = document.getElementById('page-' + p);
                if (element) element.classList.add('hidden');
            });
            document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
            const target = document.getElementById('page-' + id);
            if(target) target.classList.remove('hidden');
            if (el) el.classList.add('active');
            if(id === 'treinamentos') renderRoadmapList();
        }

        // --- ROADMAPS ---
        function renderRoadmapList() {
            const list = document.getElementById('roadmap-list');
            if(!list) return;
            list.innerHTML = roadmaps.map(r => `
                <div class="roadmap-card" onclick="openRoadmap('${r.id}')">
                    <div class="badge">ROTEIRO</div>
                    <div class="title">${r.name}</div>
                    <div class="info"><i data-lucide="user" style="width:12px"></i> Instrutor: ${r.owner || '--'}</div>
                    <div class="info"><i data-lucide="users" style="width:12px"></i> ${r.participants?.length || 0} Participantes</div>
                    <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: center;">
                        <span style="font-size: 11px; font-weight: 700; color: var(--totvs-green)">${r.items.length} PASSOS</span>
                        <button class="btn-icon delete" onclick="event.stopPropagation(); deleteRoadmap('${r.id}')"><i data-lucide="trash-2" style="width:14px"></i></button>
                    </div>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function populateStakeholders() {
            const selector = document.getElementById('participant-selector');
            if(!selector) return;
            selector.innerHTML = '<option value="">Selecione um participante...</option>';
            
            // Tentamos encontrar a coluna de Nome no Mapa de Stakeholders
            dataStore.stakeholders.forEach(stk => {
                const name = stk[0] || stk["Nome"] || stk["NOME"]; // Tenta pegar o primeiro campo ou o campo 'Nome'
                if(name && name !== "Nome" && name !== "NOME") {
                    const opt = document.createElement('option');
                    opt.value = name;
                    opt.textContent = name;
                    selector.appendChild(opt);
                }
            });
        }

        function addParticipant() {
            const selector = document.getElementById('participant-selector');
            const val = selector.value;
            if(val && !selectedParticipants.includes(val)) {
                selectedParticipants.push(val);
                renderParticipantTags();
            }
            selector.value = "";
        }

        function removeParticipant(name) {
            selectedParticipants = selectedParticipants.filter(p => p !== name);
            renderParticipantTags();
        }

        function renderParticipantTags() {
            const container = document.getElementById('participant-tags');
            if(!container) return;
            container.innerHTML = selectedParticipants.map(p => `
                <div class="participant-tag">
                    ${p} <i data-lucide="x" style="width:12px" onclick="removeParticipant('${p}')"></i>
                </div>
            `).join('');
            lucide.createIcons();
        }

        function openNewRoadmap() {
            currentRoadmapId = 'rm_' + Date.now();
            selectedParticipants = [];
            document.getElementById('edit-roadmap-name').value = "Novo Roteiro";
            document.getElementById('edit-roadmap-owner').value = "";
            document.getElementById('roadmap-items-body').innerHTML = "";
            renderParticipantTags();
            populateStakeholders();
            document.getElementById('roadmap-editor').style.display = 'block';
            addRoadmapRow(); 
            lucide.createIcons();
        }

        function openRoadmap(id) {
            const rm = roadmaps.find(r => r.id === id);
            if(!rm) return;
            currentRoadmapId = id;
            selectedParticipants = rm.participants || [];
            document.getElementById('edit-roadmap-name').value = rm.name;
            document.getElementById('edit-roadmap-owner').value = rm.owner;
            document.getElementById('roadmap-items-body').innerHTML = rm.items.map((item, i) => generateRowHtml(i + 1, item)).join('');
            
            renderParticipantTags();
            populateStakeholders();
            document.getElementById('roadmap-editor').style.display = 'block';
            lucide.createIcons();
        }

        function generateRowHtml(idx, data = {}) {
            return `<tr>
                <td style="font-size:10px; font-weight:800; color:#94a3b8">${idx}</td>
                <td><input type="text" class="row-system" placeholder="Protheus" value="${data.system || ''}"></td>
                <td><input type="text" class="row-module" placeholder="Faturamento" value="${data.module || ''}"></td>
                <td><input type="text" class="row-process" placeholder="Fluxo de Venda" value="${data.process || ''}"></td>
                <td><input type="text" class="row-task" placeholder="Gerar Nota" value="${data.task || ''}"></td>
                <td><select class="row-status">
                    <option value="Aguardando" ${data.status === 'Aguardando'?'selected':''}>Aguardando</option>
                    <option value="Em Andamento" ${data.status === 'Em Andamento'?'selected':''}>Em Andamento</option>
                    <option value="Concluído" ${data.status === 'Concluído'?'selected':''}>Concluído</option>
                </select></td>
                <td><input type="text" class="row-obs" value="${data.obs || ''}"></td>
                <td><button class="btn-icon delete" onclick="this.closest('tr').remove()"><i data-lucide="minus"></i></button></td>
            </tr>`;
        }

        function addRoadmapRow() {
            const body = document.getElementById('roadmap-items-body');
            if(!body) return;
            const tr = document.createElement('tr');
            tr.innerHTML = generateRowHtml(body.children.length + 1);
            body.appendChild(tr);
            lucide.createIcons();
        }

        function saveRoadmap() {
            const items = [];
            document.querySelectorAll('#roadmap-items-body tr').forEach(tr => {
                items.push({
                    system: tr.querySelector('.row-system').value,
                    module: tr.querySelector('.row-module').value,
                    process: tr.querySelector('.row-process').value,
                    task: tr.querySelector('.row-task').value,
                    status: tr.querySelector('.row-status').value,
                    obs: tr.querySelector('.row-obs').value
                });
            });
            const index = roadmaps.findIndex(r => r.id === currentRoadmapId);
            const rmData = {
                id: currentRoadmapId,
                name: document.getElementById('edit-roadmap-name').value,
                owner: document.getElementById('edit-roadmap-owner').value,
                participants: selectedParticipants,
                items, date: new Date().toLocaleDateString('pt-BR')
            };
            if(index > -1) roadmaps[index] = rmData; else roadmaps.push(rmData);
            localStorage.setItem('cockpit_roadmaps', JSON.stringify(roadmaps));
            showToast("Roteiro salvo com sucesso!"); closeEditor(); renderRoadmapList();
        }

        function deleteRoadmap(id) {
            roadmaps = roadmaps.filter(r => r.id !== id);
            localStorage.setItem('cockpit_roadmaps', JSON.stringify(roadmaps));
            renderRoadmapList(); showToast("Roteiro removido.");
        }

        function closeEditor() { 
            const editor = document.getElementById('roadmap-editor');
            if(editor) editor.style.display = 'none'; 
        }

        function exportRoadmapToExcel() {
            const name = document.getElementById('edit-roadmap-name').value;
            const owner = document.getElementById('edit-roadmap-owner').value;
            let csv = `ROTEIRO: ${name}\nINSTRUTOR: ${owner}\nPARTICIPANTES: ${selectedParticipants.join(', ')}\n\n`;
            csv += `ID;SISTEMA;MODULO;PROCESSO;TAREFA;STATUS;OBSERVACAO\n`;
            document.querySelectorAll('#roadmap-items-body tr').forEach((tr, i) => {
                const s = tr.querySelector('.row-system').value;
                const m = tr.querySelector('.row-module').value;
                const p = tr.querySelector('.row-process').value;
                const t = tr.querySelector('.row-task').value;
                const st = tr.querySelector('.row-status').value;
                const ob = tr.querySelector('.row-obs').value;
                csv += `${i+1};${s};${m};${p};${t};${st};${ob}\n`;
            });
            const blob = new Blob(["\ufeff" + csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = `roteiro_${name.toLowerCase().replace(/\s/g, '_')}.csv`;
            link.click();
        }

        // --- CORE SYNC ---
        function generateConfigRows() {
            const container = document.getElementById('config-rows-container');
            if(!container) return;
            container.innerHTML = Object.entries(config.sources).map(([key, item]) => `
                <div class="sheet-config-row">
                    <div class="form-group" style="margin:0"><label>${item.label}</label><input type="text" id="url-${key}" value="${item.url}" placeholder="URL CSV"></div>
                    <div class="form-group" style="margin:0"><label>Range</label><input type="text" id="range-${key}" value="${item.range}" placeholder="Ex: B5:B29"></div>
                    <div class="checkbox-group" onclick="document.getElementById('header-${key}').click()">
                        <input type="checkbox" id="header-${key}" ${item.hasHeader ? 'checked' : ''} onclick="event.stopPropagation()">
                        <label>Cabeçalho</label>
                    </div>
                </div>
            `).join('');
            lucide.createIcons();
        }

        async function fetchCSV(url, hasHeader, type) {
            if(!url) return [];
            let fetchUrl = url.includes('spreadsheets/d/') && !url.includes('format=csv') ? url.replace(/\/edit.*$/, '/export?format=csv') : url;
            const finalUrl = `${fetchUrl}${fetchUrl.includes('?') ? '&' : '?'}t=${new Date().getTime()}`;
            try {
                const resp = await fetch(finalUrl);
                const txt = await resp.text();
                const rows = txt.split(/\r?\n/).map(l => l.split(',').map(c => c.replace(/^"(.*)"$/, '$1').trim())).filter(row => row.some(cell => cell !== "")); 
                if (rows.length === 0) return [];
                
                // Double check range
                let currentRange = config.sources[type].range || "A1";
                let startPart = currentRange.split(':')[0] || "A1";
                let colPrefix = startPart.match(/[A-Z]+/)[0];
                let startRow = parseInt(startPart.match(/[0-9]+/)[0]);
                config.sources[type].range = `${startPart}:${colPrefix}${startRow + rows.length - 1}`;

                return hasHeader ? rows.slice(1) : rows;
            } catch { return []; }
        }

        async function syncAllData() {
            const icon = document.getElementById('sync-icon'); if (icon) icon.classList.add('loading-spinner');
            try {
                const keys = Object.keys(config.sources);
                const results = await Promise.all(keys.map(key => fetchCSV(config.sources[key].url, config.sources[key].hasHeader, key)));
                keys.forEach((key, i) => {
                    dataStore[key] = results[i];
                    const countEl = document.getElementById(`val-${key}`);
                    if (countEl) countEl.innerText = results[i].length;
                    renderTable(key);
                });
                const syncEl = document.getElementById('last-sync-time'); if (syncEl) syncEl.innerText = new Date().toLocaleTimeString('pt-BR');
                generateConfigRows();
                populateStakeholders(); // Atualiza a lista de participantes com os novos dados syncados
            } catch (err) { console.error(err); }
            finally { if (icon) icon.classList.remove('loading-spinner'); }
        }

        function renderTable(type) {
            const table = document.getElementById(`table-${type}`); if (!table) return;
            const thead = table.querySelector('thead'), tbody = table.querySelector('tbody'), data = dataStore[type];
            if (!data || data.length === 0) return;
            thead.innerHTML = "<tr>" + Object.keys(data[0] || {}).map(h => `<th>Col ${parseInt(h)+1}</th>`).join('') + "</tr>";
            tbody.innerHTML = data.map(row => "<tr>" + row.map(v => `<td>${v}</td>`).join('') + "</tr>").join('');
        }

        function startSyncCycle() {
            clearInterval(timerInterval);
            totalSeconds = config.interval * 60; timeLeft = totalSeconds;
            syncAllData();
            timerInterval = setInterval(() => {
                timeLeft--;
                const min = Math.floor(timeLeft / 60), sec = timeLeft % 60;
                const tEl = document.getElementById('timer-text'); if(tEl) tEl.innerText = `${min.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
                const bEl = document.getElementById('progress-fill'); if(bEl) bEl.style.width = ((timeLeft / totalSeconds) * 100) + '%';
                if(timeLeft <= 0) { syncAllData(); timeLeft = totalSeconds; }
            }, 1000);
        }

        function forceSync() { startSyncCycle(); showToast("Atualizando dados..."); }

        function saveConfig() {
            config.interval = parseInt(document.getElementById('update-interval').value);
            Object.keys(config.sources).forEach(key => {
                config.sources[key].url = document.getElementById(`url-${key}`).value;
                config.sources[key].range = document.getElementById(`range-${key}`).value;
                config.sources[key].hasHeader = document.getElementById(`header-${key}`).checked;
            });
            localStorage.setItem('cockpit_config', JSON.stringify(config));
            showToast("Configurações salvas."); startSyncCycle();
        }

        function updateDate() {
            const el = document.getElementById('current-date');
            if(!el) return;
            const now = new Date();
            el.innerText = now.toLocaleDateString('pt-BR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        }

        function initApp() {
            lucide.createIcons();
            updateDate();
            generateConfigRows();
            startSyncCycle();
            renderRoadmapList();
        }

        function showToast(m) {
            const t = document.getElementById('toast');
            const msg = document.getElementById('toast-msg');
            if(msg) msg.innerText = m;
            t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 3000);
        }

        document.getElementById('password').addEventListener('keypress', (e) => e.key === 'Enter' && handleLogin());
    </script>
</body>
</html>
